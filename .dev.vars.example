# Cloudflare Access (required in production). TEAM_DOMAIN may be the base Access URL or the full /cdn-cgi/access/certs URL.
POLICY_AUD=your-access-policy-audience-tag
TEAM_DOMAIN=https://your-team.cloudflareaccess.com

# Discord incoming-webhook URL for new-mail notifications (optional).
# Unset = notifications are skipped. Configure targets in workers/notifiers/config.ts.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/000/xxxx

# Web Push (VAPID). Generate a pair with: node -e 'import("web-push-browser").then(async (m) => console.log(await m.serializeVapidKeys(await m.generateVapidKeys())))'
# Unset = push notifications are skipped.
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:you@example.com
