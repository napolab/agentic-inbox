{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Replace every "example" value below with your own before deploying.
	// account_id is omitted: wrangler uses CLOUDFLARE_ACCOUNT_ID (or your
	// logged-in account), so no account identifier lives in git.
	"name": "agentic-inbox",
	"compatibility_date": "2025-11-28",
	"main": "./workers/app.ts",
	"workers_dev": false,
	"preview_urls": false,
	"routes": [
		{
			// Keep in sync with APP_ORIGIN in workers/notifiers/format.ts.
			"pattern": "inbox.example.com",
			"custom_domain": true
		}
	],
	"observability": {
		"enabled": true
	},
	"compatibility_flags": [
		"nodejs_compat"
	],
	"vars": {
		// POLICY_AUD is intentionally NOT set here: it is created when one-click
		// Access is enabled and stored as a Worker secret. The worker fails
		// closed (HTTP 500) until then, which is the safe default.
		// Comma-separated. Every listed domain must have its Email Routing
		// catch-all pointed at this Worker, or mail for it never arrives.
		"DOMAINS": "example.com",
		// Empty array = catch-all mode: any address on any DOMAINS entry gets a
		// mailbox. Keep the key (typegen derives Env from it); do not delete it.
		"EMAIL_ADDRESSES": [],
		"TEAM_DOMAIN": "https://your-team.cloudflareaccess.com"
	},
	"send_email": [
		{
			"name": "EMAIL",
			"remote": true
		}
	],
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "agentic-inbox",
			"preview_bucket_name": "agentic-inbox"
		}
	],
	"ai": {
		"binding": "AI"
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "MAILBOX",
				"class_name": "MailboxDO"
			},
			{
				"name": "EMAIL_AGENT",
				"class_name": "EmailAgent"
			},
			{
				"name": "EMAIL_MCP",
				"class_name": "EmailMCP"
			},
			{
				"name": "PUSH_SUBSCRIPTIONS",
				"class_name": "PushSubscriptionsDO"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"MailboxDO"
			]
		},
		{
			"tag": "v2",
			"new_sqlite_classes": [
				"EmailAgent"
			]
		},
		{
			"tag": "v3",
			"new_sqlite_classes": [
				"EmailMCP"
			]
		},
		{
			"tag": "v4",
			"new_sqlite_classes": [
				"PushSubscriptionsDO"
			]
		}
	]
}
